+/* Ask the receiver to leave PLAY before the helper removes the P2P group.
+ * The caller owns the finite wait and subsequent unconditional cleanup. */
+gboolean
+nd_wfd_p2p_sink_request_teardown (NdWFDP2PSink *self)
+{
+  if (self->state != ND_SINK_STATE_STREAMING || !self->wfd_client)
+    return FALSE;
+  wfd_client_trigger_method (self->wfd_client, "TEARDOWN");
+  return TRUE;
+}
