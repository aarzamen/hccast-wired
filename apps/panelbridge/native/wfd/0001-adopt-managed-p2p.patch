+
+  g_signal_connect_object (sink->server,
+                           "client-connected",
+                           (GCallback) client_connected_cb,
+                           sink,
+                           G_CONNECT_SWAPPED);
+
+  g_signal_connect_object (sink->server,
+                           "create-source",
+                           (GCallback) server_create_source_cb,
+                           sink,
+                           G_CONNECT_SWAPPED);
+
+  g_signal_connect_object (sink->server,
+                           "create-audio-source",
+                           (GCallback) server_create_audio_source_cb,
+                           sink,
+                           G_CONNECT_SWAPPED);
+
+  sink->state = ND_SINK_STATE_WAIT_SOCKET;
+  g_object_notify (G_OBJECT (sink), "state");
+}
+
+/* PanelBridge: adopt only a connection already activated by the narrow helper. */
+gboolean
+nd_wfd_p2p_sink_adopt_connection (NdWFDP2PSink *sink, NMActiveConnection *ac, const gchar *peer_ipv4)
+{
+  g_return_val_if_fail (sink->state == ND_SINK_STATE_DISCONNECTED, FALSE);
+  g_return_val_if_fail (NM_IS_ACTIVE_CONNECTION (ac), FALSE);
+  if (nm_device_get_active_connection (sink->nm_device) != ac ||
+      nm_active_connection_get_state (ac) != NM_ACTIVE_CONNECTION_STATE_ACTIVATED)
+    return FALSE;
+
+  sink->expected_peer_ipv4 = g_strdup (peer_ipv4);
+  sink->externally_managed_connection = TRUE;
+  sink->nm_ac = g_object_ref (ac);
+  start_rtsp (sink);
+  return sink->state == ND_SINK_STATE_WAIT_SOCKET;
+}
