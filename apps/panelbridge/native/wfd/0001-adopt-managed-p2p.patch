+      NMIPConfig *ip4 = nm_device_get_ip4_config (sink->nm_device);
+      const GPtrArray *addresses = ip4 ? nm_ip_config_get_addresses (ip4) : NULL;
+      if (!addresses || addresses->len == 0)
+        {
+          sink->state = ND_SINK_STATE_ERROR;
+          g_object_notify (G_OBJECT (sink), "state");
+          return;
+        }
+      NMIPAddress *address = g_ptr_array_index (addresses, 0);
+      gst_rtsp_server_set_address (GST_RTSP_SERVER (sink->server),
